# 'make sbom' writes sbom.protobom.bin: a protobom Document in the wire
# subset used by the go backend: Document{metadata=1,node_list=2},
# Metadata{name=3,date=4,tools=5,authors=6}, Timestamp{seconds=1},
# Tool{name=1,version=2}, Person{name=1,is_org=2}, NodeList{nodes=1,
# edges=2,root_elements=3}, Node{id=1,name=3,version=4},
# Edge{type=1,from=2,to=3}, type 10=dependsOn.
# ponytail: shell printf writer; assumes component names contain no '%'
# or backslash.  Not in CLEANFILES on purpose (rebuilt on every make).

.PHONY: sbom
sbom: sbom.protobom.bin

sbom.protobom.bin:
	@LC_ALL=C; \
	v() { v=$$1; while [ "$$v" -gt 127 ]; do \
	  printf "\\$$(printf '%o' $$(( (v & 127) | 128 )))"; \
	  v=$$((v / 128)); \
	done; printf "\\$$(printf '%o' $$v)"; }; \
	s() { printf "\\$$(printf '%o' $$(($$1 * 8 + 2)))"; \
	  p=$$2; v $${#p}; printf '%s' "$$p"; }; \
	sec=$${SOURCE_DATE_EPOCH-`date +%s`}; \
	ts=$$(printf '\010')$$(v $$sec); \
	meta=$$(s 3 "$(PACKAGE)")$$(s 4 "$$ts")$$(s 5 "$$(s 1 automake)$$(s 2 "$(VERSION)")")$$(s 6 "$$(s 1 "$(PACKAGE)")$$(printf '\020\001')"); \
	nl=$$(s 1 "$$(s 1 "$(PACKAGE)")$$(s 3 "$(PACKAGE)")$$(s 4 "$(VERSION)")"); \
	for c in $(am__sbom_components); do \
	  nl=$$nl$$(s 1 "$$(s 1 "$$c")$$(s 3 "$$c")$$(s 4 "$(VERSION)")"); \
	  nl=$$nl$$(s 2 "$$(printf '\010\012'; s 2 "$(PACKAGE)"; s 3 "$$c")"); \
	done; \
	{ s 1 "$$meta"; s 2 "$$nl"; } > sbom.protobom.bin

all-am: $(AM_SBOM_TARGET)

 .../invoker/mvn/CommonsCliMavenOptions.java   | 13 +++
 .../invoker/mvn/LayeredMavenOptions.java      |  5 +
 .../maven/cling/invoker/mvn/MavenInvoker.java |  9 ++
 .../cling/invoker/mvn/SbomReportWriter.java   | 94 +++++++++++++++++++
 .../mvn/CommonsCliMavenOptionsSbomTest.java   | 47 ++++++++++
 6 files changed, 181 insertions(+)
 create mode 100644 impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java
 create mode 100644 impl/maven-cli/src/test/java/org/apache/maven/cling/invoker/mvn/CommonsCliMavenOptionsSbomTest.java

diff --git a/api/maven-api-cli/src/main/java/org/apache/maven/api/cli/mvn/MavenOptions.java b/api/maven-api-cli/src/main/java/org/apache/maven/api/cli/mvn/MavenOptions.java
index 6cbce22d..05bd0e48 100644
--- a/api/maven-api-cli/src/main/java/org/apache/maven/api/cli/mvn/MavenOptions.java
+++ b/api/maven-api-cli/src/main/java/org/apache/maven/api/cli/mvn/MavenOptions.java
@@ -253,4 +253,17 @@ public interface MavenOptions extends Options {
      */
     @Nonnull
     Optional<Boolean> listAliases();
+
+    /**
+     * Indicates that an SBOM report should be written after the build completes.
+     * The report is written to {@code sbom.json} in the top-level project directory.
+     * The report lists the resolved dependencies of every built project as protobom-style
+     * components; supplier, license and hash are omitted as Maven does not retain them
+     * in the resolved artifact set.
+     *
+     * @return an {@link Optional} containing the report file name, or empty if not specified
+     * @since 4.2.0
+     */
+    @Nonnull
+    Optional<String> sbomFile();
 }
diff --git a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/CommonsCliMavenOptions.java b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/CommonsCliMavenOptions.java
index bdeaf179..436d5a94 100644
--- a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/CommonsCliMavenOptions.java
+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/CommonsCliMavenOptions.java
@@ -252,6 +252,14 @@ public Optional<Boolean> listAliases() {
         return commandLine.hasOption(CLIManager.LIST_ALIASES) ? Optional.of(true) : Optional.empty();
     }
 
+    @Override
+    public Optional<String> sbomFile() {
+        if (commandLine.hasOption(CLIManager.SBOM)) {
+            return Optional.of("sbom.json");
+        }
+        return Optional.empty();
+    }
+
     @Override
     protected CommonsCliMavenOptions copy(
             String source, CommonsCliOptions.CLIManager cliManager, CommandLine commandLine) {
@@ -286,6 +294,7 @@ protected static class CLIManager extends CommonsCliOptions.CLIManager {
         public static final String METADATA_UPDATE_POLICY = "metadata-update-policy";
         public static final String AT_FILE = "af";
         public static final String LIST_ALIASES = "list-aliases";
+        public static final String SBOM = "sbom";
 
         @Override
         protected void prepareOptions(org.apache.commons.cli.Options options) {
@@ -432,6 +441,10 @@ protected void prepareOptions(org.apache.commons.cli.Options options) {
                     .longOpt(LIST_ALIASES)
                     .desc("List effective build aliases defined in settings files and exit.")
                     .get());
+            options.addOption(Option.builder()
+                    .longOpt(SBOM)
+                    .desc("Write an SBOM report (sbom.json) to the top-level project directory after the build")
+                    .get());
         }
     }
 }
diff --git a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/LayeredMavenOptions.java b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/LayeredMavenOptions.java
index 51fef1b8..31d1be05 100644

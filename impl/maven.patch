+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/MavenInvoker.java
@@ -19,6 +19,7 @@
 package org.apache.maven.cling.invoker.mvn;
 
 import java.io.FileNotFoundException;
+import java.io.IOException;
 import java.nio.file.Files;
 import java.nio.file.Path;
 import java.util.ArrayList;
@@ -570,6 +571,16 @@ protected int doExecute(MavenContext context, MavenExecutionRequest request) thr
             context.eventSpyDispatcher.close();
         }
 
+        if (!result.hasExceptions()) {
+            context.options().sbomFile().ifPresent(file -> {
+                try {
+                    SbomReportWriter.write(request.getTopDirectory().resolve(file), result);
+                } catch (IOException e) {
+                    context.logger.warn("Failed to write SBOM report: " + e.getMessage());
+                }
+            });
+        }
+
         if (result.hasExceptions()) {
             ExceptionHandler handler = new DefaultExceptionHandler();
             boolean hasDetailedHelp = false;
diff --git a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java
new file mode 100644
index 00000000..4c6091f6
--- /dev/null
+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java
@@ -0,0 +1,148 @@

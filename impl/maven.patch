+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/LayeredMavenOptions.java
@@ -179,6 +179,11 @@ public Optional<Boolean> listAliases() {
         return returnFirstPresentOrEmpty(MavenOptions::listAliases);
     }
 
+    @Override
+    public Optional<String> sbomFile() {
+        return returnFirstPresentOrEmpty(MavenOptions::sbomFile);
+    }
+
     @Override
     public MavenOptions interpolate(UnaryOperator<String> callback) {
         ArrayList<MavenOptions> interpolatedOptions = new ArrayList<>(options.size());
diff --git a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/MavenInvoker.java b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/MavenInvoker.java
index 929386aa..14f3462d 100644
--- a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/MavenInvoker.java
+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/MavenInvoker.java
@@ -19,6 +19,7 @@
 package org.apache.maven.cling.invoker.mvn;
 
 import java.io.FileNotFoundException;
+import java.io.IOException;
 import java.nio.file.Files;
 import java.nio.file.Path;
 import java.util.ArrayList;
@@ -570,6 +571,14 @@ protected int doExecute(MavenContext context, MavenExecutionRequest request) thr
             context.eventSpyDispatcher.close();
         }
 
+        context.options().sbomFile().ifPresent(file -> {
+            try {
+                SbomReportWriter.write(request.getTopDirectory().resolve(file), result);
+            } catch (IOException e) {
+                context.logger.warn("Failed to write SBOM report: " + e.getMessage());
+            }
+        });
+
         if (result.hasExceptions()) {
             ExceptionHandler handler = new DefaultExceptionHandler();
             boolean hasDetailedHelp = false;
diff --git a/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java
new file mode 100644
index 00000000..56726e1f
--- /dev/null
+++ b/impl/maven-cli/src/main/java/org/apache/maven/cling/invoker/mvn/SbomReportWriter.java
@@ -0,0 +1,94 @@

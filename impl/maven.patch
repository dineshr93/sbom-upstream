+package org.apache.maven.cling.invoker.mvn;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Guards the {@code --sbom} option: it takes no argument, so a following goal must
+ * not be swallowed as its value.
+ */
+class CommonsCliMavenOptionsSbomTest {
+
+    @Test
+    void testSbomFlagDoesNotSwallowFollowingGoal() throws Exception {
+        CommonsCliMavenOptions options = CommonsCliMavenOptions.parse("test", new String[] {"--sbom", "package"});
+
+        assertTrue(options.sbomFile().isPresent(), "sbomFile must be present");
+        assertEquals("sbom.json", options.sbomFile().get());
+        assertEquals(java.util.List.of("package"), options.goals().orElseThrow(), "goal must survive");
+    }
+
+    @Test
+    void testSbomAbsentByDefault() throws Exception {
+        CommonsCliMavenOptions options = CommonsCliMavenOptions.parse("test", new String[] {"package"});
+
+        assertTrue(options.sbomFile().isEmpty(), "sbomFile must be empty without the flag");
+    }
+}

diff --git a/mesonbuild/sbom.py b/mesonbuild/sbom.py
new file mode 100644
index 0000000..4f9b8cf
--- /dev/null
+++ b/mesonbuild/sbom.py
@@ -0,0 +1,154 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Meson development team
+
+"""Minimal protobom SBOM writer.
+
+Emits a protobom Document as protobuf binary. Only varint and
+length-delimited wire types are needed, so the encoder is hand-rolled and
+Meson gains no protobuf runtime dependency.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+import typing as T
+
+from . import build, coredata
+from .mesonlib import MesonException
+
+# protobom field numbers, from protobom/api/sbom.proto.
+_DOC_METADATA = 1
+_DOC_NODE_LIST = 2
+_META_NAME = 3
+_META_DATE = 4
+_META_TOOLS = 5
+_TOOL_NAME = 1
+_TOOL_VERSION = 2
+_TS_SECONDS = 1
+_NODELIST_NODES = 1
+_NODELIST_EDGES = 2
+_NODE_ID = 1
+_NODE_NAME = 3
+_NODE_VERSION = 4
+_NODE_IDENTIFIERS = 28
+_EDGE_TYPE = 1
+_EDGE_FROM = 2
+_EDGE_TO = 3
+_EDGE_DEPENDS_ON = 10
+_ID_PURL = 1
+
+
+def _varint(n: int) -> bytes:
+    out = bytearray()
+    while True:
+        b = n & 0x7f
+        n >>= 7
+        if n:
+            out.append(b | 0x80)
+        else:
+            out.append(b)
+            return bytes(out)
+
+
+def _tag(field: int, wire: int) -> bytes:
+    return _varint((field << 3) | wire)
+
+
+def _int(field: int, n: int) -> bytes:
+    return _tag(field, 0) + _varint(n)
+
+
+def _bytes(field: int, data: bytes) -> bytes:
+    return _tag(field, 2) + _varint(len(data)) + data
+
+
+def _str(field: int, s: str) -> bytes:
+    return _bytes(field, s.encode())
+
+
+def _msg(field: int, parts: T.Iterable[bytes]) -> bytes:
+    return _bytes(field, b''.join(parts))
+
+
+def _map_int_str(field: int, items: T.Mapping[int, str]) -> bytes:
+    return b''.join(_msg(field, [_int(1, k), _str(2, items[k])])
+                    for k in sorted(items))
+
+
+def _purl(name: str, version: T.Optional[str]) -> T.Optional[str]:
+    if not version or version == 'unknown':
+        return None
+    # ponytail: no percent-encoding; Meson target names are path-safe.
+    return f'pkg:generic/{name}@{version}'
+
+
+def _dependency_id(name: str, version: T.Optional[str]) -> str:
+    purl = _purl(name, version)
+    if purl:
+        return purl
+    if version and version != 'unknown':
+        return f'{name}@{version}'
+    return name
+
+
+def _node(nid: str, name: str, version: T.Optional[str], purl: T.Optional[str]) -> bytes:
+    parts = [_str(_NODE_ID, nid), _str(_NODE_NAME, name)]
+    if version and version != 'unknown':
+        parts.append(_str(_NODE_VERSION, version))
+    if purl:
+        parts.append(_map_int_str(_NODE_IDENTIFIERS, {_ID_PURL: purl}))
+    return _msg(_NODELIST_NODES, parts)
+
+
+def _timestamp() -> int:
+    sde = os.environ.get('SOURCE_DATE_EPOCH')
+    if sde:
+        try:
+            return int(sde)
+        except ValueError:
+            pass
+    return int(time.time())
+
+
+def build_document(b: build.Build, timestamp: int) -> bytes:
+    version = b.project_version or ''
+    nodes: T.Dict[str, bytes] = {}
+    edges: T.Set[T.Tuple[str, str]] = set()
+
+    for target in b.get_targets().values():
+        nid = target.get_id()
+        nodes[nid] = _node(nid, target.name, version, _purl(target.name, version))
+        if not isinstance(target, build.BuildTarget):
+            continue
+        for dep in target.get_all_link_deps():
+            edges.add((nid, dep.get_id()))
+        for dep in target.get_external_deps():
+            dname = dep.get_name()
+            dver = dep.get_version()
+            dpurl = _purl(dname, dver)
+            did = _dependency_id(dname, dver)
+            if did not in nodes:
+                nodes[did] = _node(did, dname, dver, dpurl)
+            edges.add((nid, did))
+
+    meta = [
+        _str(_META_NAME, b.project_name),
+        _msg(_META_DATE, [_int(_TS_SECONDS, timestamp)]),
+        _msg(_META_TOOLS, [_str(_TOOL_NAME, 'meson'),
+                           _str(_TOOL_VERSION, coredata.version)]),
+    ]
+    node_list = [nodes[k] for k in sorted(nodes)]
+    node_list += [_msg(_NODELIST_EDGES, [_int(_EDGE_TYPE, _EDGE_DEPENDS_ON),
+                                         _str(_EDGE_FROM, f), _str(_EDGE_TO, t)])
+                  for f, t in sorted(edges)]
+    return _msg(_DOC_METADATA, meta) + _msg(_DOC_NODE_LIST, node_list)
+
+
+def emit(b: build.Build, path: str) -> None:
+    data = build_document(b, _timestamp())
+    try:
+        with open(path, 'wb') as f:
+            f.write(data)
+    except OSError as e:
+        raise MesonException(f'Could not write SBOM to {path}: {e}')
diff --git a/unittests/sbomtests.py b/unittests/sbomtests.py
new file mode 100644
index 0000000..1109d23
--- /dev/null
+++ b/unittests/sbomtests.py
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 The Meson development team
+
+import os
+import unittest
+
+from mesonbuild import sbom
+
+from .baseplatformtests import BasePlatformTests
+
+GOLDEN = ('0a1c1a0464656d6f22060880e2cfaa062a0c0a056d65736f6e1203312e30'
+          '123b0a390a13706b673a67656e657269632f61707040312e301a03617070'
+          '2203312e30e2011708011213706b673a67656e657269632f61707040312e30')
+
+
+class SbomEncoderTests(unittest.TestCase):
+
+    def test_external_dep_without_version(self):
+        did = sbom._dependency_id('libfoo', None)
+        self.assertEqual(did, 'libfoo')
+        self.assertNotIn('None', did)
+
+    def test_golden(self):
+        doc = sbom._msg(sbom._DOC_METADATA, [
+            sbom._str(sbom._META_NAME, 'demo'),
+            sbom._msg(sbom._META_DATE, [sbom._int(sbom._TS_SECONDS, 1700000000)]),
+            sbom._msg(sbom._META_TOOLS, [sbom._str(sbom._TOOL_NAME, 'meson'),
+                                         sbom._str(sbom._TOOL_VERSION, '1.0')]),
+        ]) + sbom._msg(sbom._DOC_NODE_LIST, [
+            sbom._node('pkg:generic/app@1.0', 'app', '1.0', 'pkg:generic/app@1.0'),
+        ])
+        self.assertEqual(doc.hex(), GOLDEN)
+
+
+class SbomSetupTests(BasePlatformTests):
+
+    def _project(self):
+        srcdir = self.builddir + '-src'
+        os.makedirs(srcdir)
+        with open(os.path.join(srcdir, 'meson.build'), 'w', encoding='utf-8') as f:
+            f.write("project('demo', 'c', version: '1.0')\n"
+                    "executable('app', 'app.c')\n")
+        with open(os.path.join(srcdir, 'app.c'), 'w', encoding='utf-8') as f:
+            f.write('int main(void) { return 0; }\n')
+        return srcdir
+
+    def test_setup_emits_sbom(self):
+        srcdir = self._project()
+        self.init(srcdir, extra_args=['--sbom'])
+        path = os.path.join(self.builddir, 'sbom.protobom.bin')
+        self.assertPathExists(path)
+        with open(path, 'rb') as f:
+            data = f.read()
+        self.assertIn(b'demo', data)
+        self.assertIn(b'app@exe', data)
+        self.assertIn(b'pkg:generic/app@1.0', data)
+
+    def test_deterministic(self):
+        srcdir = self._project()
+        os.environ['SOURCE_DATE_EPOCH'] = '1700000000'
+        self.init(srcdir, extra_args=['--sbom'])
+        path = os.path.join(self.builddir, 'sbom.protobom.bin')
+        with open(path, 'rb') as f:
+            first = f.read()
+        self.init(srcdir, extra_args=['--sbom', '--reconfigure'])
+        with open(path, 'rb') as f:
+            second = f.read()
+        self.assertEqual(first, second)
+
+    def test_off_by_default(self):
+        srcdir = self._project()
+        self.init(srcdir)
+        self.assertPathDoesNotExist(os.path.join(self.builddir, 'sbom.protobom.bin'))
